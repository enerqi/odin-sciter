// odin-c-bindgen configuration for the Sciter.JS C ABI.
//
// Run with `just bindgen` (which invokes ../odin-c-bindgen/bindgen.bin on this folder).
//
// Only `sciter-x-api.h` is fed in: it transitively includes sciter-x-types.h, sciter-x-def.h,
// sciter-x-dom.h, sciter-x-request.h, sciter-x-msg.h and value.h, which between them carry the whole
// C ABI. The remaining headers in external/sciter/include are C++ conveniences (aux-*.h, *.hpp) or
// optional subsystems, and feeding the whole folder in would generate a file per header plus a lot of
// noise from the C++-only ones.
//
// The `clang_defines` below are the important part - see docs/PLAN.md section 5:
//
//   LINUX      - pick a platform branch in sciter-x-primitives.h / sciter-x-types.h. Without one of
//                WINDOWS/OSX/LINUX/ANDROID defined, none of the primitive typedefs (SBOOL, WCHAR,
//                UINT_PTR, RECT, ...) exist at all.
//   WINDOWLESS - skips the `#include <gtk/gtk.h>` that the LINUX branch would otherwise do, and makes
//                HWINDOW a `void*` instead of `GtkWidget*`. HWINDOW is a rawptr in Odin either way, and
//                libgtk-3-dev is then not needed to generate bindings.
//
// Defining WINDOWLESS is safe for layout: there are ZERO `#if defined(WINDOWLESS)` guards inside the
// ISciterAPI struct body (verified - the only WINDOWLESS uses are the HWINDOW typedef, the
// SCITER_DLL_NAME choice, and the SCITER_API_VERSION value). The generated struct is byte-identical to
// the one a windowed build would produce.
//
// Consequence to be aware of: the platform-specific slots that Sciter NULL-pads on non-native platforms
// (SciterProc, SciterProcND, SciterTranslateMessage, SciterRenderD2D, SciterD2DFactory, SciterDWFactory,
// the three DirectX entry points, SciterCreateNSView) come out as `rawptr` rather than typed procs.
// That is correct for every platform's layout; typed accessors for the few that are actually useful are
// hand-written in src/prelude.odin.

inputs = [
	"build/sciter.h"
]

clang_include_paths = [
	"external/sciter/include"
]

// Two of these patch over genuine gaps in the headers when they are parsed as C (libclang parses .h as
// C, so every `#ifdef __cplusplus` branch is skipped):
//
//   char16_t - a built-in type in C++, but in C it needs `#include <uchar.h>`, which sciter-x-primitives.h
//              never does. (The header even has a commented-out `//#define char16_t uint16_t` where the
//              author hit this.) `__CHAR16_TYPE__` is a clang built-in macro, always defined, and expands
//              to the correct 16-bit unsigned type without needing any include.
//   INT_PTR  - used by SciterExec/SciterWindowExec in sciter-x-def.h and sciter-x-api.h, but the
//              non-Windows branches of sciter-x-primitives.h only ever typedef UINT_PTR. Upstream bug.
//              `intptr_t` is the right stand-in: bindgen maps that spelling to Odin `c.intptr_t`,
//              which is pointer-sized everywhere. src/flatten_headers.py adds the <stdint.h> it needs.
clang_defines = {
	"LINUX" = "1"
	"char16_t" = "__CHAR16_TYPE__"
}

// Output folder: one .odin file per processed header.
output_folder = "."

package_name = "sciter"

// Code pasted near the top of the generated file: the dynamic loader, the `api()` accessor and the
// typed wrappers for the slots that come out as rawptr above.
imports_file = "src/prelude.odin"

force_ada_case_types = true

// Retype a few C typedefs onto Odin types of the same size but better behaviour.
type_overrides = {
	// `typedef int SBOOL` - a 4-byte C int, so it must NOT become Odin's 1-byte `bool`. `b32` is the
	// same 4 bytes and makes the API usable: `if api.SciterLoadHtml(...)` instead of `... != 0`, and
	// `api.SciterVersion(true)` instead of `api.SciterVersion(1)`.
	"SBOOL" = "b32"

	// `const BYTE*` / `BYTE*` are always buffer pointers here (HTML source, CSS source, resource
	// blobs), never pointers to one byte. `[^]u8` is the Odin spelling for that, and it is what
	// `raw_data(some_string)` and `raw_data(some_slice)` produce.
	//
	// This only reaches the parameters that spell the type `LPCBYTE`; the four that are written out as
	// `const BYTE*` are handled one at a time in procedure_type_overrides below. (There is no LPBYTE:
	// the headers name it in two doc comments but never typedef it.)
	"LPCBYTE" = "[^]u8"

	// Same reasoning for UTF-16 strings: LPCWSTR is a pointer to a NUL-terminated run of code units.
	"LPCWSTR" = "[^]u16"
	"LPWSTR" = "[^]u16"

	// `typedef const char* LPCSTR`, and every one of its 29 uses is a NUL-terminated name - a tag, an
	// attribute name, a method name, a mime type. That is exactly Odin's `cstring`, and it is what a
	// string literal converts to for free. Without this it comes out as `^i8`, which cannot be passed
	// a literal at all.
	//
	// The one exception is LPCSTR_RECEIVER's `str`, which comes with an explicit length and is not
	// promised to be terminated; it is overridden back to `[^]u8` below.
	"LPCSTR" = "cstring"

	// `typedef size_t UINT_PTR` comes out as `c.size_t` (Odin `uint`). It is pointer-sized either way,
	// but half its uses are genuinely pointers passed through SciterExec / SciterPostCallback / the
	// SCITER_APP_INIT argv, and `uintptr` lets those be written as one cast instead of two.
	"UINT_PTR" = "uintptr"
}

// ---------------------------------------------------------------------------------------------------
// Flag enums -> bit_set
//
// The key is the C enum tag; the value names the *member* enum that the bit_set is built over. The
// generated pair is `Foo_Bar :: bit_set[Foo_Ba; u32]` - so the plural, C-named type stays the one that
// appears in signatures, and the singular is only ever written as `.MEMBER`. bindgen log2s the member
// values, keeps the enum's C storage type (all of these are `u32`, so the ABI is unchanged), and turns
// any member that is not a single bit into a named constant of the bit_set type.
//
// Only enums whose members are genuinely independent bits belong here. Two enums that look like
// candidates are deliberately absent - see the note below the table.
bit_setify = {
	// EVENT_GROUPS is the subscription mask handed to SciterWindowAttachEventHandler and the `evtg`
	// argument of every ELEMENT_EVENT_PROC. HANDLE_ALL (0xFFFF) and SUBSCRIPTIONS_REQUEST (0xFFFFFFFF)
	// are multi-bit, so they come out as constants rather than members.
	//
	// One casualty: HANDLE_INITIALIZATION is 0, and bindgen drops zero-valued members (a bit_set has no
	// bit for them). That is correct here - initialization events are delivered whatever the mask says,
	// and the value the engine passes in `evtg` for them is the empty set.
	"EVENT_GROUPS" = "Event_Group"

	// SW_MAIN | SW_ENABLE_DEBUG is the common case and reads badly as `u32(...) | u32(...)`.
	"SCITER_CREATE_WINDOW_FLAGS" = "Sciter_Create_Window_Flag"

	// The :link / :hover / :active / ... pseudo-class bits. 30 members, every one a distinct bit.
	"ELEMENT_STATE_BITS" = "Element_State_Bit"

	// ALLOW_FILE_IO | ALLOW_SOCKET_IO | ... , the value side of SCITER_SET_SCRIPT_RUNTIME_FEATURES.
	"SCRIPT_RUNTIME_FEATURES" = "Script_Runtime_Feature"

	// SCROLL_TO_TOP (0x01) and SCROLL_SMOOTH (0x10).
	"SCITER_SCROLL_FLAGS" = "Sciter_Scroll_Flag"

	// MOUSE_PARAMS::button_state is every button held at once, not one of them: left-and-right together
	// is 3, and an ordinary move with nothing held is 0. Neither is a value of the C enum, so the enum
	// shape produced an invalid value on the *common* path - see the tests in examples/events.odin.
	"MOUSE_BUTTONS" = "Mouse_Button"

	// KEYBOARD_STATES the same, for MOUSE_PARAMS::alt_state and KEY_PARAMS::alt_state. Its SHIFT,
	// CONTROL, ALT and COMMAND members are not extra keys but the left-or-right pairs ORed together, so
	// they come out of bindgen as multi-bit constants of the bit_set type, which is exactly right.
	"KEYBOARD_STATES" = "Keyboard_State"

	// VALUE_UNIT_TYPE_DATE - HAS_DATE, HAS_TIME, HAS_SECONDS and UTC combine: a full timestamp carries
	// three of them at once. Note this one is *not* reachable through a typed slot, because ValueType's
	// pUnits stays a ^Uint (see the note further down); it is the shape that matters.
	"VALUE_UNIT_TYPE_DATE" = "Value_Unit_Date"
}

// NOT bit_setified, though docs/PLAN.md section 7 lists them - both would generate values that compile
// and are wrong:
//
//   OUTPUT_SUBSYTEMS - OT_DOM=0, OT_CSSS=1, OT_CSS=2, OT_SCRIPT=3. A plain sequence, not flags. As a
//     bit_set, DOM would be deleted outright (zero-valued) and SCRIPT would become the constant
//     `{.CSSS, .CSS}`. It is an alternation, so it stays an enum.
//
//   ELEMENT_AREAS - packs two small alternations and one flag into one UINT: the low bits select what
//     the rectangle is relative to (ROOT_RELATIVE=1, SELF_RELATIVE=2, CONTAINER_RELATIVE=3,
//     VIEW_RELATIVE=4 - note 3, which is *not* ROOT|SELF), the next bits select which box
//     (CONTENT_BOX=0x00, PADDING_BOX=0x10, BORDER_BOX=0x20, MARGIN_BOX=0x30, BACK_IMAGE_AREA=0x40,
//     FORE_IMAGE_AREA=0x50, SCROLLABLE_AREA=0x60 - again a sequence), and AS_PPX=0x8000 on top. Only
//     AS_PPX is a real flag. A bit_set would make `{.ROOT_RELATIVE, .VIEW_RELATIVE}` (= 5) and
//     `{.PADDING_BOX, .BORDER_BOX, .BACK_IMAGE_AREA}` (= 0x70) expressible and meaningless, and would
//     hide the real rule, which is "pick one from each group and add them".

// ---------------------------------------------------------------------------------------------------
// Parameters and returns that are an enum wearing a UINT
//
// The header says what these are only in a comment - `UINT areas /*ELEMENT_AREAS*/`, `UINT appCmd /**/`
// - so bindgen sees a bare integer and there is nothing to infer from. Keys are the C names:
// `Struct.field.parameter` for a slot of the API table, `Proc.parameter` for a typedef'd callback, and
// the same key without a parameter for a return type. Values are written in *Odin* spelling, because
// they are pasted verbatim into the output.
//
// The API table's C tag is `_ISciterAPI` (`typedef struct _ISciterAPI { ... } ISciterAPI;`), which is
// why every key below starts with the underscore.
procedure_type_overrides = {
	// --- application and window lifecycle ---------------------------------------------------------
	"_ISciterAPI.SciterExec.appCmd"                = "Sciter_App_Cmd"
	"_ISciterAPI.SciterWindowExec.windowCmd"       = "Sciter_Window_Cmd"
	"_ISciterAPI.SciterCreateWindow.creationFlags" = "Sciter_Create_Window_Flags"
	"_ISciterAPI.SciterSetOption.option"           = "Sciter_Rt_Options"

	// SciterWindowExec's `p1` is deliberately NOT typed as Sciter_Window_State, though docs/PLAN.md
	// section 7 suggests it: it is only a window state for SET_STATE. For SET_PLACEMENT it is a
	// `const POINT*`, for ACTIVATE a BOOL, for GET_VULKAN_CONTEXT a struct pointer. `uintptr` is the
	// only type that is right for all of them.

	// --- DOM ------------------------------------------------------------------------------------
	"_ISciterAPI.SciterGetElementState.pstateBits"     = "^Element_State_Bits"
	"_ISciterAPI.SciterSetElementState.stateBitsToSet"   = "Element_State_Bits"
	"_ISciterAPI.SciterSetElementState.stateBitsToClear" = "Element_State_Bits"
	"_ISciterAPI.SciterScrollToView.SciterScrollFlags"   = "Sciter_Scroll_Flags"
	"_ISciterAPI.SciterSetElementHtml.where"             = "Set_Element_Html"
	"_ISciterAPI.SciterControlGetType.pType"             = "^Ctl_Type"
	"_ISciterAPI.SciterNodeType.pNodeType"               = "^Node_Type"

	// SciterGetElementLocation's `areas` stays a UINT - see the ELEMENT_AREAS note above. It is a
	// packed pair of alternations, so neither an enum nor a bit_set describes it.

	// --- events ---------------------------------------------------------------------------------
	"_ISciterAPI.SciterWindowAttachEventHandler.subscription" = "Event_Groups"

	// The loader's two entry points. `dataType` is echoed straight back to the requester in
	// DATA_ARRIVED_PARAMS.dataType, which is typed to match above, so leaving these as UINT would make
	// the round trip need a cast at one end and not the other.
	"_ISciterAPI.SciterRequestElementData.dataType" = "Sciter_Resource_Type"
	"_ISciterAPI.SciterHttpRequest.dataType"        = "Sciter_Resource_Type"
	"_ISciterAPI.SciterHttpRequest.requestType"     = "Request_Type"

	// The handler side of the same mask. On a normal call the engine passes exactly one group; when it
	// is asking a handler what it wants to receive it passes SUBSCRIPTIONS_REQUEST, and the handler
	// writes a mask back through `prms`. Both are Event_Groups values.
	"ElementEventProc.evtg" = "Event_Groups"

	// --- values ---------------------------------------------------------------------------------
	// ValueType's `pUnits` is left as ^Uint on purpose, though docs/PLAN.md section 7 pairs it with
	// pType: which enum it holds is decided by pType. It is VALUE_UNIT_TYPE only for T_LENGTH; for
	// T_DATE it is VALUE_UNIT_TYPE_DATE, for T_OBJECT VALUE_UNIT_TYPE_OBJECT, for T_STRING
	// VALUE_UNIT_TYPE_STRING, for T_UNDEFINED VALUE_UNIT_UNDEFINED. Naming one of them would make the
	// other four look wrong.
	"_ISciterAPI.ValueType.pType" = "^Value_Type"

	// --- SCDOM_RESULT returns ---------------------------------------------------------------------
	// `#define SCDOM_RESULT INT`, so clang sees a bare `int` on all 101 DOM slots and there is nothing
	// to key off but the name. The list is generated from the header with:
	//
	//   grep -oP 'SCDOM_RESULT\s+SCFN\(\s*\K\w+' external/sciter/include/sciter-x-api.h
	//
	// A slot added by a future SDK just keeps returning `Int` until it is added here - visible, and
	// better than a rule that guesses.
	"_ISciterAPI.Sciter_UseElement" = "Scdom_Result"
	"_ISciterAPI.Sciter_UnuseElement" = "Scdom_Result"
	"_ISciterAPI.SciterGetRootElement" = "Scdom_Result"
	"_ISciterAPI.SciterGetFocusElement" = "Scdom_Result"
	"_ISciterAPI.SciterFindElement" = "Scdom_Result"
	"_ISciterAPI.SciterGetChildrenCount" = "Scdom_Result"
	"_ISciterAPI.SciterGetNthChild" = "Scdom_Result"
	"_ISciterAPI.SciterGetParentElement" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementHtmlCB" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementTextCB" = "Scdom_Result"
	"_ISciterAPI.SciterSetElementText" = "Scdom_Result"
	"_ISciterAPI.SciterGetAttributeCount" = "Scdom_Result"
	"_ISciterAPI.SciterGetNthAttributeNameCB" = "Scdom_Result"
	"_ISciterAPI.SciterGetNthAttributeValueCB" = "Scdom_Result"
	"_ISciterAPI.SciterGetAttributeByNameCB" = "Scdom_Result"
	"_ISciterAPI.SciterSetAttributeByName" = "Scdom_Result"
	"_ISciterAPI.SciterClearAttributes" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementIndex" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementType" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementTypeCB" = "Scdom_Result"
	"_ISciterAPI.SciterGetStyleAttributeCB" = "Scdom_Result"
	"_ISciterAPI.SciterSetStyleAttribute" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementLocation" = "Scdom_Result"
	"_ISciterAPI.SciterScrollToView" = "Scdom_Result"
	"_ISciterAPI.SciterUpdateElement" = "Scdom_Result"
	"_ISciterAPI.SciterRefreshElementArea" = "Scdom_Result"
	"_ISciterAPI.SciterSetCapture" = "Scdom_Result"
	"_ISciterAPI.SciterReleaseCapture" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementHwnd" = "Scdom_Result"
	"_ISciterAPI.SciterCombineURL" = "Scdom_Result"
	"_ISciterAPI.SciterSelectElements" = "Scdom_Result"
	"_ISciterAPI.SciterSelectElementsW" = "Scdom_Result"
	"_ISciterAPI.SciterSelectParent" = "Scdom_Result"
	"_ISciterAPI.SciterSelectParentW" = "Scdom_Result"
	"_ISciterAPI.SciterSetElementHtml" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementUID" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementByUID" = "Scdom_Result"
	"_ISciterAPI.SciterShowPopup" = "Scdom_Result"
	"_ISciterAPI.SciterShowPopupAt" = "Scdom_Result"
	"_ISciterAPI.SciterHidePopup" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementState" = "Scdom_Result"
	"_ISciterAPI.SciterSetElementState" = "Scdom_Result"
	"_ISciterAPI.SciterCreateElement" = "Scdom_Result"
	"_ISciterAPI.SciterCloneElement" = "Scdom_Result"
	"_ISciterAPI.SciterInsertElement" = "Scdom_Result"
	"_ISciterAPI.SciterDetachElement" = "Scdom_Result"
	"_ISciterAPI.SciterDeleteElement" = "Scdom_Result"
	"_ISciterAPI.SciterSetTimer" = "Scdom_Result"
	"_ISciterAPI.SciterDetachEventHandler" = "Scdom_Result"
	"_ISciterAPI.SciterAttachEventHandler" = "Scdom_Result"
	"_ISciterAPI.SciterWindowAttachEventHandler" = "Scdom_Result"
	"_ISciterAPI.SciterWindowDetachEventHandler" = "Scdom_Result"
	"_ISciterAPI.SciterSendEvent" = "Scdom_Result"
	"_ISciterAPI.SciterPostEvent" = "Scdom_Result"
	"_ISciterAPI.SciterCallBehaviorMethod" = "Scdom_Result"
	"_ISciterAPI.SciterRequestElementData" = "Scdom_Result"
	"_ISciterAPI.SciterHttpRequest" = "Scdom_Result"
	"_ISciterAPI.SciterGetScrollInfo" = "Scdom_Result"
	"_ISciterAPI.SciterSetScrollPos" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementIntrinsicWidths" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementIntrinsicHeight" = "Scdom_Result"
	"_ISciterAPI.SciterIsElementVisible" = "Scdom_Result"
	"_ISciterAPI.SciterIsElementEnabled" = "Scdom_Result"
	"_ISciterAPI.SciterSortElements" = "Scdom_Result"
	"_ISciterAPI.SciterSwapElements" = "Scdom_Result"
	"_ISciterAPI.SciterTraverseUIEvent" = "Scdom_Result"
	"_ISciterAPI.SciterCallScriptingMethod" = "Scdom_Result"
	"_ISciterAPI.SciterCallScriptingFunction" = "Scdom_Result"
	"_ISciterAPI.SciterEvalElementScript" = "Scdom_Result"
	"_ISciterAPI.SciterAttachHwndToElement" = "Scdom_Result"
	"_ISciterAPI.SciterControlGetType" = "Scdom_Result"
	"_ISciterAPI.SciterGetValue" = "Scdom_Result"
	"_ISciterAPI.SciterSetValue" = "Scdom_Result"
	"_ISciterAPI.SciterGetExpando" = "Scdom_Result"
	"_ISciterAPI.SciterGetObject" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementNamespace" = "Scdom_Result"
	"_ISciterAPI.SciterGetHighlightedElement" = "Scdom_Result"
	"_ISciterAPI.SciterSetHighlightedElement" = "Scdom_Result"
	"_ISciterAPI.SciterNodeAddRef" = "Scdom_Result"
	"_ISciterAPI.SciterNodeRelease" = "Scdom_Result"
	"_ISciterAPI.SciterNodeCastFromElement" = "Scdom_Result"
	"_ISciterAPI.SciterNodeCastToElement" = "Scdom_Result"
	"_ISciterAPI.SciterNodeFirstChild" = "Scdom_Result"
	"_ISciterAPI.SciterNodeLastChild" = "Scdom_Result"
	"_ISciterAPI.SciterNodeNextSibling" = "Scdom_Result"
	"_ISciterAPI.SciterNodePrevSibling" = "Scdom_Result"
	"_ISciterAPI.SciterNodeParent" = "Scdom_Result"
	"_ISciterAPI.SciterNodeNthChild" = "Scdom_Result"
	"_ISciterAPI.SciterNodeChildrenCount" = "Scdom_Result"
	"_ISciterAPI.SciterNodeType" = "Scdom_Result"
	"_ISciterAPI.SciterNodeGetText" = "Scdom_Result"
	"_ISciterAPI.SciterNodeSetText" = "Scdom_Result"
	"_ISciterAPI.SciterNodeInsert" = "Scdom_Result"
	"_ISciterAPI.SciterNodeRemove" = "Scdom_Result"
	"_ISciterAPI.SciterCreateTextNode" = "Scdom_Result"
	"_ISciterAPI.SciterCreateCommentNode" = "Scdom_Result"
	"_ISciterAPI.SciterFireEvent" = "Scdom_Result"
	"_ISciterAPI.SciterGetElementAsset" = "Scdom_Result"
	"_ISciterAPI.SciterEGLSendEvent" = "Scdom_Result"
	"_ISciterAPI.SciterRequestAnimationFrameEvent" = "Scdom_Result"
	"_ISciterAPI.SciterRequestPaint" = "Scdom_Result"

	// --- VALUE_RESULT returns ----------------------------------------------------------------------
	// Same story as SCDOM_RESULT, with a twist: the VALUE_RESULT enum does exist in value.h, but every
	// slot is declared `UINT SCFN( Value... )`, so clang never connects the two. Worse, HV_OK_TRUE is
	// -1, which as the declared UINT reads as 4294967295. The enum is `i32`, so the size is unchanged
	// and `.OK_TRUE` compares correctly.
	"_ISciterAPI.ValueInit" = "Value_Result"
	"_ISciterAPI.ValueClear" = "Value_Result"
	"_ISciterAPI.ValueCompare" = "Value_Result"
	"_ISciterAPI.ValueCopy" = "Value_Result"
	"_ISciterAPI.ValueIsolate" = "Value_Result"
	"_ISciterAPI.ValueType" = "Value_Result"
	"_ISciterAPI.ValueStringData" = "Value_Result"
	"_ISciterAPI.ValueStringDataSet" = "Value_Result"
	"_ISciterAPI.ValueIntData" = "Value_Result"
	"_ISciterAPI.ValueIntDataSet" = "Value_Result"
	"_ISciterAPI.ValueInt64Data" = "Value_Result"
	"_ISciterAPI.ValueInt64DataSet" = "Value_Result"
	"_ISciterAPI.ValueFloatData" = "Value_Result"
	"_ISciterAPI.ValueFloatDataSet" = "Value_Result"
	"_ISciterAPI.ValueBinaryData" = "Value_Result"
	"_ISciterAPI.ValueBinaryDataSet" = "Value_Result"
	"_ISciterAPI.ValueElementsCount" = "Value_Result"
	"_ISciterAPI.ValueNthElementValue" = "Value_Result"
	"_ISciterAPI.ValueNthElementValueSet" = "Value_Result"
	"_ISciterAPI.ValueNthElementKey" = "Value_Result"
	"_ISciterAPI.ValueEnumElements" = "Value_Result"
	"_ISciterAPI.ValueSetValueToKey" = "Value_Result"
	"_ISciterAPI.ValueGetValueOfKey" = "Value_Result"
	"_ISciterAPI.ValueToString" = "Value_Result"
	"_ISciterAPI.ValueFromString" = "Value_Result"
	"_ISciterAPI.ValueInvoke" = "Value_Result"
	"_ISciterAPI.ValueNativeFunctorSet" = "Value_Result"

	// The VALUE_TYPE / VALUE_UNIT_TYPE_* / VALUE_STRING_CVT_TYPE arguments of the same API. `units` is
	// left alone for the same reason as ValueType.pUnits - which enum it is depends on `type`.
	"_ISciterAPI.ValueIntDataSet.type"    = "Value_Type"
	"_ISciterAPI.ValueInt64DataSet.type"  = "Value_Type"
	"_ISciterAPI.ValueFloatDataSet.type"  = "Value_Type"
	"_ISciterAPI.ValueBinaryDataSet.type" = "Value_Type"
	"_ISciterAPI.ValueToString.how"       = "Value_String_Cvt_Type"
	"_ISciterAPI.ValueFromString.how"     = "Value_String_Cvt_Type"

	// --- byte buffers written as `const BYTE*` --------------------------------------------------
	// `[^]` augments the existing type rather than replacing it, so `^Byte` becomes `[^]Byte`. These
	// are the four parameters the LPCBYTE type_override cannot see, because the header spells them out
	// instead of using the typedef.
	"_ISciterAPI.SciterSetElementHtml.html"           = "[^]"
	"SciterGraphicsAPI.imageLoad.bytes"               = "[^]"
	"SciterGraphicsAPI.imageCreateFromPixmap.pixmap"  = "[^]"
	"image_write_function.data"                       = "[^]"

	// ... and the pixmap layout that goes with the buffer above.
	"SciterGraphicsAPI.imageCreateFromPixmap.pixmap_format" = "Sciter_Pixmap_Format"

	// The receivers hand back a pointer *and* a length, and nothing promises a terminator, so this one
	// LPCSTR is a counted UTF-8 buffer rather than a cstring.
	"LPCSTR_RECEIVER.str" = "[^]u8"

	// --- diagnostics ----------------------------------------------------------------------------
	"DEBUG_OUTPUT_PROC.subsystem" = "Output_Subsytems"
	"DEBUG_OUTPUT_PROC.severity"  = "Output_Severity"
}

// The SCDOM_* `#define`s that `Scdom_Result` in src/prelude.odin replaces. Leaving them would give
// every result code two spellings, one of which (`SCDOM_RESULT :: Int`) is a type that no signature
// uses any more.
remove = [
	"SCDOM_RESULT"
	"SCDOM_OK"
	"SCDOM_INVALID_HWND"
	"SCDOM_INVALID_HANDLE"
	"SCDOM_PASSIVE_HANDLE"
	"SCDOM_INVALID_PARAMETER"
	"SCDOM_OPERATION_FAILED"
	"SCDOM_OK_NOT_HANDLED"
]

// ---------------------------------------------------------------------------------------------------
// Renames
//
// `force_ada_case_types` is right for the ~250 type names that read as words, but it is a faithful
// transliteration, so Windows-style Hungarian tags survive as `Lpcwstr`, `Sbool`, `Hsarchive`. Those
// three plus LPCBYTE are the ones that turn up in signatures a caller has to write, so they get real
// names. Everything else keeps its upstream spelling - the point of `package sciter` is that
// sciter.com's documentation reads across to it (see docs/PLAN.md section 10).
//
// Renaming happens before Ada-casing and takes the C name as key, so the value is the final spelling.
rename = {
	// `typedef int SBOOL`, retyped to `b32` above. `Sbool` says nothing; `Bool32` says the one thing
	// that matters about it, which is that it is not Odin's 1-byte `bool`.
	"SBOOL" = "Bool32"

	// Both are `[^]u16` after the type_overrides above: a NUL-terminated run of UTF-16 code units.
	// Sciter takes UTF-16 everywhere a string comes back out of the engine.
	"LPCWSTR" = "Wide_String"
	"LPWSTR"  = "Wide_String_Buffer"

	// `[^]u8` - HTML source, CSS source, resource blobs. `raw_data(some_string)` produces one.
	"LPCBYTE" = "Bytes"

	// The callbacks the `...CB` getters hand their result to. Named after what they receive.
	"LPCWSTR_RECEIVER" = "Wide_String_Receiver"
	"LPCSTR_RECEIVER"  = "Utf8_Receiver"
	"LPCBYTE_RECEIVER" = "Bytes_Receiver"

	// The handle from SciterOpenArchive, used with SciterGetArchiveItem / SciterCloseArchive.
	"HSARCHIVE" = "Archive"
}

// ---------------------------------------------------------------------------------------------------
// Struct fields that are an enum wearing a UINT
//
// Same idea as `procedure_type_overrides` above, for fields rather than parameters. Keys are
// `CStructName.field_name`.
//
// The event parameter structs are where this matters: the header types every one of their fields as
// UINT and names the real type in a trailing comment, so nothing is inferable. The three below are the
// two mask fields, which now have a bit_set to point at.
struct_field_overrides = {
	// "every button held", not "which button" - see the MOUSE_BUTTONS note in bit_setify.
	"MOUSE_PARAMS.button_state" = "Mouse_Buttons"

	// "every modifier down", likewise, on both structs that carry one.
	"MOUSE_PARAMS.alt_state" = "Keyboard_States"
	"KEY_PARAMS.alt_state"   = "Keyboard_States"

	// The rest of the event structs' UINT-wearing-an-enum fields. Every one below is unconditional -
	// the header names exactly one enum and it holds for every value of the surrounding `cmd`, which is
	// what separates them from the conditional ones left alone further down. Each replaces a cast that
	// `sciter_app` was doing by hand.
	"MOUSE_PARAMS.cursor_type"    = "Cursor_Type"
	"MOUSE_PARAMS.dragging_mode"  = "Dragging_Type"
	"SCROLL_PARAMS.source"        = "Scroll_Source"
	"EXCHANGE_PARAMS.mode"        = "Dd_Modes"
	"DATA_ARRIVED_PARAMS.dataType" = "Sciter_Resource_Type"
	"SCN_LOAD_DATA.dataType"       = "Sciter_Resource_Type"
	"SCN_DATA_LOADED.dataType"     = "Sciter_Resource_Type"

	// Left as UINT on purpose, all for the same reason the `cmd` fields are - which enum they hold is
	// decided by something else in the struct:
	//
	//   SCROLL_PARAMS.reason      - a key code when `source` is KEYBOARD, a SCROLLBAR_PART when it is
	//                               SCROLLBAR, and nothing at all otherwise.
	//   FOCUS_PARAMS.cause        - a FOCUS_CMD_TYPE only for FOCUS_ADVANCE_REQUEST.
	//   SCN_SET_CURSOR.cursorId   - a CURSOR_TYPE only when `cursorUrl` is NULL.
	//   KEY_PARAMS.key_code       - a virtual key for DOWN/UP, a character for CHAR. Not an enum either
	//                               way; there is no upstream list to name it against.
	//   BEHAVIOR_EVENT_PARAMS.reason - a CLICK_REASON or an EDIT_CHANGED_REASON, chosen by `cmd`.

	// The `cmd` fields are deliberately NOT typed. Every one of them is an event code with the
	// propagation phase ORed in - `MOUSE_DOWN | SINKING` is not a MOUSE_EVENTS value - and the mouse
	// group ORs `DRAGGING` (0x100) on top of that. `sciter_app/events.odin` splits the three apart;
	// naming one enum here would assert something false about the other two bits.
}

// The automatic "strip the prefix all members share" pass gets SET_ELEMENT_HTML wrong: its members are
// SIH_* (inner html) and SOH_* (outer html), whose shared prefix is the single letter `S`, so they come
// out as `IH_REPLACE_CONTENT` / `OH_REPLACE` - names that appear nowhere upstream. No member starts with
// the string below, so nothing is stripped; setting the key at all is what turns the automatic pass off.
remove_enum_member_prefix = {
	"SET_ELEMENT_HTML" = "SET_ELEMENT_HTML_"
}
